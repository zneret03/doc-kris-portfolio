# Copy to .env.local for local overrides. On Vercel, set these in the project settings.

# Canonical origin for metadata, sitemap, structured data and social preview
# images. Social networks need absolute image URLs, so set this in production.
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Only needed once the on-site request form is back on the clinic page (it's
# parked while patients book on SeriousMD). Where consultation requests are
# delivered: a JSON POST endpoint such as an inbox relay, CRM webhook or
# automation tool. Without it the form tells patients to call instead.
CONSULTATION_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <secret>" with each request.
CONSULTATION_WEBHOOK_SECRET=
